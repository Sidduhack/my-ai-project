{
  "version": 2,
  "name": "nvidia-multi-agent-builder-frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "framework": "vite",
  "build": {
    "env": {
      "NODE_VERSION": "18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_BACKEND_URL/api/$1"
    },
    {
      "source": "/models/(.*)",
      "destination": "https://YOUR_BACKEND_URL/models/$1"
    },
    {
      "source": "/agents/(.*)",
      "destination": "https://YOUR_BACKEND_URL/agents/$1"
    },
    {
      "source": "/projects/(.*)",
      "destination": "https://YOUR_BACKEND_URL/projects/$1"
    },
    {
      "source": "/system/(.*)",
      "destination": "https://YOUR_BACKEND_URL/system/$1"
    },
    {
      "source": "/ws",
      "destination": "wss://YOUR_BACKEND_URL/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}